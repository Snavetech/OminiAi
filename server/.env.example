# ============================================================================
# Snave AI - Environment Variables Example
# ============================================================================

# Server Port
PORT=3000

# AgentRouter Configuration
# Get your API key and check available models at: https://agentrouter.org/console
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Supported AgentRouter models: gpt-6-astra (updated knowledge), gpt-6.1-sol, gpt-5.6-sol
AGENTROUTER_MODEL=gpt-6-astra

# (Alternative) Groq API Key (ultra-fast free tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# HuggingFace API Token (free tier, for image generation)
# Get yours at: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_token_here
